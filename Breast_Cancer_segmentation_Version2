{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":19971525}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import os\nimport glob\nimport cv2\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom PIL import Image\n\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nimport albumentations as A\nfrom albumentations.pytorch import ToTensorV2\n\n# ---------------------------------------------------------\n# 1. Dataset & Data Pipeline Setup\n# ---------------------------------------------------------\nclass BreastCancerDataset(Dataset):\n    \"\"\"\n    Parses ultrasound images and merges multiple mask files \n    (e.g., tumor + sub-lesions) into a single binary ground-truth target.\n    \"\"\"\n    def __init__(self, root_dir, image_paths, transform=None):\n        self.root_dir = root_dir\n        self.image_paths = image_paths\n        self.transform = transform\n\n    def __len__(self):\n        return len(self.image_paths)\n\n    def __getitem__(self, idx):\n        img_path = self.image_paths[idx]\n        \n        # Load grayscale ultrasound as 3-channel RGB for convolutional backbone\n        image = cv2.imread(img_path)\n        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n\n        # Locate corresponding masks\n        base_name = img_path.replace(\".png\", \"\")\n        mask_pattern = f\"{base_name}_mask*.png\"\n        mask_files = glob.glob(mask_pattern)\n\n        # Aggregate multiple masks into one binary canvas via bitwise OR\n        combined_mask = np.zeros((image.shape[0], image.shape[1]), dtype=np.uint8)\n        for mf in mask_files:\n            m = cv2.imread(mf, cv2.IMREAD_GRAYSCALE)\n            if m is not None:\n                combined_mask = np.bitwise_or(combined_mask, m)\n\n        # Normalize mask values to binary 0.0 or 1.0\n        combined_mask = (combined_mask > 0).astype(np.float32)\n\n        if self.transform is not None:\n            augmented = self.transform(image=image, mask=combined_mask)\n            image = augmented[\"image\"]\n            mask = augmented[\"mask\"]\n            # Add channel dimension: (H, W) -> (1, H, W)\n            mask = mask.unsqueeze(0)\n\n        return image, mask\n\ndef get_dataloaders(data_dir, batch_size=16, split_ratio=0.85):\n    # Use '**' and recursive=True to search all subdirectories automatically\n    search_path = os.path.join(data_dir, \"**\", \"*.png\")\n    all_files = glob.glob(search_path, recursive=True)\n    \n    # Filter out the mask files to get only the base images\n    image_paths = [f for f in all_files if \"_mask\" not in f]\n    \n    # FAST FAIL: Check if images were actually found\n    assert len(image_paths) > 0, f\"CRITICAL ERROR: 0 images found at {data_dir}. Check your dataset path!\"\n    print(f\"Success: Found {len(image_paths)} base ultrasound images.\")\n\n    np.random.seed(42)\n    np.random.shuffle(image_paths)\n\n    split_idx = int(len(image_paths) * split_ratio)\n    train_paths = image_paths[:split_idx]\n    val_paths = image_paths[split_idx:]\n\n    train_transform = A.Compose([\n        A.Resize(256, 256),\n        A.HorizontalFlip(p=0.5),\n        A.VerticalFlip(p=0.2),\n        A.RandomRotate90(p=0.5),\n        A.ShiftScaleRotate(shift_limit=0.0625, scale_limit=0.1, rotate_limit=15, p=0.5),\n        A.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),\n        ToTensorV2(),\n    ])\n\n    val_transform = A.Compose([\n        A.Resize(256, 256),\n        A.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),\n        ToTensorV2(),\n    ])\n\n    train_ds = BreastCancerDataset(data_dir, train_paths, transform=train_transform)\n    val_ds = BreastCancerDataset(data_dir, val_paths, transform=val_transform)\n\n    train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True, num_workers=2, pin_memory=True)\n    val_loader = DataLoader(val_ds, batch_size=batch_size, shuffle=False, num_workers=2, pin_memory=True)\n\n    return train_loader, val_loader, val_paths\n   \n\n\n# ---------------------------------------------------------\n# 2. U-Net Architecture Construction\n# ---------------------------------------------------------\nclass DoubleConv(nn.Module):\n    \"\"\"Two sequential Conv2D -> BatchNorm -> ReLU layers\"\"\"\n    def __init__(self, in_channels, out_channels):\n        super(DoubleConv, self).__init__()\n        self.conv = nn.Sequential(\n            nn.Conv2d(in_channels, out_channels, kernel_size=3, padding=1, bias=False),\n            nn.BatchNorm2d(out_channels),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(out_channels, out_channels, kernel_size=3, padding=1, bias=False),\n            nn.BatchNorm2d(out_channels),\n            nn.ReLU(inplace=True)\n        )\n\n    def forward(self, x):\n        return self.conv(x)\n\n\nclass UNet(nn.Module):\n    \"\"\"\n    Standard U-Net with contracting path, bottleneck, expanding path, \n    and feature-level skip connections.\n    \"\"\"\n    def __init__(self, in_channels=3, out_channels=1, features=[64, 128, 256, 512]):\n        super(UNet, self).__init__()\n        self.downs = nn.ModuleList()\n        self.ups = nn.ModuleList()\n        self.pool = nn.MaxPool2d(kernel_size=2, stride=2)\n\n        # Encoder (Contracting Path)\n        curr_in = in_channels\n        for feature in features:\n            self.downs.append(DoubleConv(curr_in, feature))\n            curr_in = feature\n\n        # Bottleneck\n        self.bottleneck = DoubleConv(features[-1], features[-1] * 2)\n\n        # Decoder (Expanding Path)\n        for feature in reversed(features):\n            self.ups.append(\n                nn.ConvTranspose2d(feature * 2, feature, kernel_size=2, stride=2)\n            )\n            self.ups.append(DoubleConv(feature * 2, feature))\n\n        # Final projection to binary mask logits\n        self.final_conv = nn.Conv2d(features[0], out_channels, kernel_size=1)\n\n    def forward(self, x):\n        skip_connections = []\n\n        for down in self.downs:\n            x = down(x)\n            skip_connections.append(x)\n            x = self.pool(x)\n\n        x = self.bottleneck(x)\n        skip_connections = skip_connections[::-1]\n\n        for idx in range(0, len(self.ups), 2):\n            x = self.ups[idx](x)\n            skip_connection = skip_connections[idx // 2]\n            \n            # Concatenate along channel dimension (B, C, H, W) -> dim=1\n            concat_x = torch.cat((skip_connection, x), dim=1)\n            x = self.ups[idx + 1](concat_x)\n\n        return self.final_conv(x)\n\n\n# ---------------------------------------------------------\n# 3. Loss Functions & Evaluation Metrics\n# ---------------------------------------------------------\nclass CombinedBCEAndDiceLoss(nn.Module):\n    def __init__(self, eps=1e-6):\n        super(CombinedBCEAndDiceLoss, self).__init__()\n        self.bce = nn.BCEWithLogitsLoss()\n        self.eps = eps\n\n    def forward(self, logits, targets):\n        bce_loss = self.bce(logits, targets)\n        \n        probs = torch.sigmoid(logits)\n        intersection = (probs * targets).sum(dim=(2, 3))\n        union = probs.sum(dim=(2, 3)) + targets.sum(dim=(2, 3))\n        \n        dice_score = (2.0 * intersection + self.eps) / (union + self.eps)\n        dice_loss = 1.0 - dice_score.mean()\n        \n        return bce_loss + dice_loss\n\n\ndef compute_metrics(logits, targets, threshold=0.5, eps=1e-6):\n    \"\"\"Computes Dice Similarity Coefficient and IoU at a fixed probability threshold.\"\"\"\n    probs = torch.sigmoid(logits)\n    preds = (probs > threshold).float()\n\n    intersection = (preds * targets).sum(dim=(2, 3))\n    total_area = preds.sum(dim=(2, 3)) + targets.sum(dim=(2, 3))\n    union = total_area - intersection\n\n    dice = (2.0 * intersection + eps) / (total_area + eps)\n    iou = (intersection + eps) / (union + eps)\n\n    return dice.mean().item(), iou.mean().item()\n\n\n# ---------------------------------------------------------\n# 4. Training Engine\n# ---------------------------------------------------------\ndef train_model(model, train_loader, val_loader, criterion, optimizer, epochs=15, device=\"cuda\"):\n    model.to(device)\n    best_dice = 0.0\n\n    for epoch in range(epochs):\n        model.train()\n        train_loss = 0.0\n\n        for images, masks in train_loader:\n            images = images.to(device)\n            masks = masks.to(device)\n\n            optimizer.zero_grad()\n            logits = model(images)\n            loss = criterion(logits, masks)\n            loss.backward()\n            optimizer.step()\n\n            train_loss += loss.item() * images.size(0)\n\n        train_loss /= len(train_loader.dataset)\n\n        # Validation phase\n        model.eval()\n        val_loss = 0.0\n        val_dice = 0.0\n        val_iou = 0.0\n\n        with torch.no_grad():\n            for images, masks in val_loader:\n                images = images.to(device)\n                masks = masks.to(device)\n\n                logits = model(images)\n                loss = criterion(logits, masks)\n                val_loss += loss.item() * images.size(0)\n\n                d, j = compute_metrics(logits, masks)\n                val_dice += d * images.size(0)\n                val_iou += j * images.size(0)\n\n        val_loss /= len(val_loader.dataset)\n        val_dice /= len(val_loader.dataset)\n        val_iou /= len(val_loader.dataset)\n\n        print(f\"Epoch {epoch+1:02d}/{epochs:02d} | \"\n              f\"Train Loss: {train_loss:.4f} | \"\n              f\"Val Loss: {val_loss:.4f} | \"\n              f\"Val Dice: {val_dice:.4f} | \"\n              f\"Val IoU: {val_iou:.4f}\")\n\n        if val_dice > best_dice:\n            best_dice = val_dice\n            torch.save(model.state_dict(), \"best_unet_breast_cancer.pth\")\n\n    print(f\"\\nTraining Complete. Best Validation Dice: {best_dice:.4f}\")\n\n\n# ---------------------------------------------------------\n# 5. Visual Inference & Qualitative Inspection\n# ---------------------------------------------------------\ndef visualize_predictions(model, val_loader, device=\"cuda\", count=3):\n    model.eval()\n    inv_normalize = A.Normalize(\n        mean=[-0.485/0.229, -0.456/0.224, -0.406/0.225],\n        std=[1/0.229, 1/0.224, 1/0.225],\n        max_pixel_value=1.0\n    )\n\n    images, masks = next(iter(val_loader))\n    images = images.to(device)\n\n    with torch.no_grad():\n        logits = model(images)\n        preds = (torch.sigmoid(logits) > 0.5).float()\n\n    images = images.cpu().numpy()\n    masks = masks.cpu().numpy()\n    preds = preds.cpu().numpy()\n\n    fig, axes = plt.subplots(count, 3, figsize=(12, 4 * count))\n    for i in range(count):\n        # Transpose image (C, H, W) -> (H, W, C)\n        img = np.transpose(images[i], (1, 2, 0))\n        img = (img - img.min()) / (img.max() - img.min())\n\n        axes[i, 0].imshow(img)\n        axes[i, 0].set_title(\"Input Ultrasound\")\n        axes[i, 0].axis(\"off\")\n\n        axes[i, 1].imshow(masks[i, 0], cmap=\"gray\")\n        axes[i, 1].set_title(\"Ground Truth Mask\")\n        axes[i, 1].axis(\"off\")\n\n        axes[i, 2].imshow(preds[i, 0], cmap=\"gray\")\n        axes[i, 2].set_title(\"Predicted Boundary\")\n        axes[i, 2].axis(\"off\")\n\n    plt.tight_layout()\n    plt.show()\n\n\n# ---------------------------------------------------------\n# Execution Block\n# ---------------------------------------------------------\nif __name__ == \"__main__\":\n    # Point to the root Kaggle input folder where datasets are stored\n    DATASET_DIR = \"/kaggle/input/\"\n    DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n\n    # This will now print exactly how many images it found before proceeding\n    train_loader, val_loader, _ = get_dataloaders(DATASET_DIR, batch_size=16)\n    \n    model = UNet(in_channels=3, out_channels=1)\n    criterion = CombinedBCEAndDiceLoss()\n    optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)\n\n    train_model(model, train_loader, val_loader, criterion, optimizer, epochs=15, device=DEVICE)\n    visualize_predictions(model, val_loader, device=DEVICE, count=4)","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-09-25T04:36:41.047699Z","iopub.execute_input":"2026-09-25T04:36:41.048078Z","iopub.status.idle":"2026-09-25T04:45:50.255375Z","shell.execute_reply.started":"2026-09-25T04:36:41.048049Z","shell.execute_reply":"2026-09-25T04:45:50.254523Z"}},"outputs":[{"name":"stdout","text":"Success: Found 780 base ultrasound images.\n","output_type":"stream"},{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/albumentations/core/validation.py:114: UserWarning: ShiftScaleRotate is a special case of Affine transform. Please use Affine transform instead.\n  original_init(self, **validated_kwargs)\n","output_type":"stream"},{"name":"stdout","text":"Epoch 01/15 | Train Loss: 1.3770 | Val Loss: 1.5732 | Val Dice: 0.2008 | Val IoU: 0.1288\nEpoch 02/15 | Train Loss: 1.1772 | Val Loss: 1.1887 | Val Dice: 0.3546 | Val IoU: 0.2675\nEpoch 03/15 | Train Loss: 1.1245 | Val Loss: 1.1147 | Val Dice: 0.4935 | Val IoU: 0.4049\nEpoch 04/15 | Train Loss: 1.0921 | Val Loss: 1.1161 | Val Dice: 0.4564 | Val IoU: 0.3673\nEpoch 05/15 | Train Loss: 1.0625 | Val Loss: 1.0912 | Val Dice: 0.4476 | Val IoU: 0.3617\nEpoch 06/15 | Train Loss: 1.0302 | V